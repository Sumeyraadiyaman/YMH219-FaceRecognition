<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>YMH219_FaceRecognition</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenCV'nin C# kütüphanesi, Windows için yerel dosyaları ve Bitmap dönüştürücü -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20261107" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yüz algılama modeli programla birlikte çıktı klasörüne kopyalansın -->
    <None Update="Models\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
